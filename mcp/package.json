{
  "name": "chat-with-docs-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server cho \"Chat với tài liệu\": hỏi đáp có nguồn trên tài liệu của người dùng qua API backend",
  "type": "module",
  "bin": {
    "chat-with-docs-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.6.3",
    "vitest": "4.1.12"
  }
}
