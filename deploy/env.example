# Biến môi trường mẫu cho môi trường phát triển cục bộ (Docker Compose).
#
# CHỈ DÙNG ĐỂ PHÁT TRIỂN. Mọi mật khẩu dưới đây là giá trị mẫu công khai, không dùng cho môi trường thật.
# Cách dùng: docker compose đọc tệp này làm giá trị mặc định. Để ghi đè hoặc thêm khóa thật,
# tạo `deploy/.env` (đã được .gitignore bỏ qua) rồi đặt lại biến cần đổi. KHÔNG commit khóa API.
#
# Giá trị ngưỡng lấy từ docs/implement/implement_plan.md mục 10.3 và app/config.py. Mỗi ngưỡng ghi
# nguồn quyết định trong ngoặc vuông; giá trị hiện tại là TẠM THỜI cho tới khi được chốt.

# ---------------------------------------------------------------- Hạ tầng (Docker Compose)
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat_dev_password
POSTGRES_DB=chat

# Cổng mở ra máy chủ (chỉ gắn vào 127.0.0.1). Đổi trong deploy/.env nếu bị trùng cổng.
POSTGRES_PORT=5432
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---------------------------------------------------------------- Kết nối của ứng dụng
ENVIRONMENT=local
LOG_LEVEL=INFO
# Tên máy `postgres`, `objectstore` là tên dịch vụ trong mạng Docker Compose.
DATABASE_URL=postgresql+psycopg://chat:chat_dev_password@postgres:5432/chat

S3_ENDPOINT_URL=http://objectstore:9000
S3_ACCESS_KEY=chat_s3
S3_SECRET_KEY=chat_s3_dev_password
S3_BUCKET=documents
S3_REGION=us-east-1
# Mã hóa phía máy chủ của kho đối tượng [OQ-005]: "AES256" hoặc "aws:kms" khi kho hỗ trợ; trống = tắt
S3_SERVER_SIDE_ENCRYPTION=
S3_CREATE_BUCKET=true

# ---------------------------------------------------------------- Xác thực [DQ-003]
# local = tài khoản nội bộ (mặc định khi chưa có IdP); oidc = IdP của tổ chức
AUTH_MODE=local
SESSION_IDLE_HOURS=8
# Trình duyệt chấp nhận cookie Secure trên http://localhost; môi trường thật luôn dùng HTTPS
COOKIE_SECURE=true
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
# Chỉ cần khi AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/api/v1/auth/oidc/callback

# ---------------------------------------------------------------- Dịch vụ AI (Kịch bản A) [OQ-006]
# fake = adapter giả lập (không gọi dịch vụ ngoài), claude = Claude API
ANSWER_PROVIDER=fake
# Khóa API: đặt trong deploy/.env, không ghi ở đây
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-5-5
ANSWER_EFFORT=medium
ANSWER_SERVER_FALLBACK=true

# Embedding: local = mô hình chạy nội bộ (tải ~2,3 GB lần đầu vào volume model_cache);
# hash = giả lập tất định, chỉ để phát triển giao diện/kiểm thử
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
HF_HOME=/models

# ---------------------------------------------------------------- Ngưỡng và tham số (mục 10.3)
# Tải lên [OQ-004]
MAX_FILE_BYTES=20971520
MAX_DOCS_PER_USER=50
MIN_TEXT_CHARS=20

# Hỏi đáp [PQ-002, OQ-002]
MAX_QUESTION_CHARS=2000
HISTORY_TURNS=4
# [PQ-004] Xóa hội thoại không hoạt động quá số ngày này (kèm tin nhắn, trích dẫn, đánh giá); 0 = không xóa
MESSAGE_RETENTION_DAYS=60
ANSWER_TIMEOUT_S=60

# Chunk, truy xuất (khởi điểm từ spike T0-07; chốt bằng bộ đánh giá T4-01)
CHUNK_TOKENS=500
CHUNK_OVERLAP=80
TOP_K=8
MAX_CHUNKS_PER_DOC=4
EMBED_BATCH=32
# [AQ-002] Điểm = 1 - khoảng cách cosine. Hiệu chỉnh bằng bộ đánh giá.
MIN_RELEVANCE_SCORE=0.35

# Giao diện
POLL_INTERVAL_S=3

# Xóa dữ liệu và kiểm toán [OQ-012]
PURGE_SLA_HOURS=24
AUDIT_RETENTION_DAYS=365

# Worker
JOB_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2
QUEUE_MAX_AGE_S=600
