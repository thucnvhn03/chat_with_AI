        <mxCell id="lblP" value="Tác nhân chính" style="text;html=1;align=left;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="150" y="60" width="140" height="24" as="geometry"/></mxCell>
