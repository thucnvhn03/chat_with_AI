        <mxCell id="note1" value="Ghi chú: mọi use case trong hệ thống yêu cầu người dùng đã đăng nhập (UC-14) thông qua tác nhân trừu tượng &quot;Người dùng đã đăng nhập&quot;. Phạm vi chia sẻ tài liệu: [TBD: OQ-003]. Dịch vụ AI bên ngoài: chờ xác nhận OQ-006." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="660" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="legend" value="Chú giải: đường liền = association; nét đứt + «include» = bắt buộc; nét đứt + «extend» = tùy chọn; mũi tên rỗng đặc = generalization. Nguồn: PRD.md (US-001..024), BRD.md v0.2." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="330" y="850" width="1080" height="40" as="geometry"/></mxCell>
        <mxCell id="title" value="Use Case Diagram — Chat với tài liệu (MVP) — UML 2.0" style="text;html=1;align=left;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="700" height="30" as="geometry"/></mxCell>
